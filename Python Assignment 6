    "## 3 Visualizations using Matplotlib / Pandas Plot\n",
    "# 1 Line Chart – Fare over Time\n",
    "\n",
    "# Convert pickup column to datetime\n",
    "df['pickup'] = pd.to_datetime(df['pickup'])\n",
    "\n",
    "# Sort data by pickup timestamp\n",
    "df = df.sort_values('pickup')\n",
    "\n",
    "# Plot line chart\n",
    "plt.figure(figsize=(5,3))\n",
    "\n",
    "plt.plot(df['pickup'], df['fare'])\n",
    "\n",
    "plt.xlabel('Pickup Timestamp')\n",
    "plt.ylabel('Fare')\n",
    "plt.title('Fare Over Time')\n",
    "\n",
    "plt.xticks(rotation=45)\n",
    "plt.tight_layout()\n",
    "plt.show()\n"
